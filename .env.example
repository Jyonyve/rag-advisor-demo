# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
BASE=/

# Optional development-only retrieval trace. Query text can be sensitive.
RAG_ADVISOR_RAG_TRACE=false

# Optional local smoke-test settings
RAG_ADVISOR_DEMO_LOCAL_BASE_URL=http://localhost:3000
RAG_ADVISOR_DEMO_SMOKE_EMAIL=
RAG_ADVISOR_DEMO_SMOKE_PASSWORD=

# Optional JSONL flow logging. Use 1 to disable file logging on ephemeral hosts.
RAG_ADVISOR_DEMO_DISABLE_JSONL_LOGS=0

# Public web/client domains
VITE_APP_ENV=development
VITE_APP_DOMAIN=http://localhost:3000
VITE_API_DOMAIN=http://localhost:3000

# SuperTokens
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=
DASHBOARD_ADMIN_EMAILS=

# PostgreSQL + pgvector
DATABASE_URL=postgresql://advisor:advisor@localhost:5432/rag_advisor_demo
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Runtime uploaded files
LOCAL_IMAGE_STORAGE_DIR=public/assets

# Optional read-only archived conversation demo
PUBLIC_DEMO_ENABLED=false
PUBLIC_DEMO_SESSION_ID=
PUBLIC_DEMO_TITLE=Demo conversation
PUBLIC_DEMO_CHARACTER_NAME=Character
PUBLIC_DEMO_VIEWER_NAME=Guest
PUBLIC_DEMO_MAX_TURNS=100

# Authenticated one-click public demo. All settings below are server-only (never VITE_*).
PUBLIC_DEMO_MODE=false
PUBLIC_LLM_ENABLED=false

# Server-managed chat/report credential. Keep separate from the embedding credential.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_REPORT_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low

# Per-guest live-generation allowances and fixed request/output bounds.
DEMO_CHAT_LIMIT=5
DEMO_REPORT_LIMIT=1
DEMO_CHAT_MAX_OUTPUT_TOKENS=800
DEMO_REPORT_MAX_OUTPUT_TOKENS=1800
DEMO_MAX_INPUT_CHARS=1200

# Persisted global daily limits and database-reserved concurrent capacity.
DEMO_GLOBAL_DAILY_CHAT_LIMIT=30
DEMO_GLOBAL_DAILY_REPORT_LIMIT=6
DEMO_MAX_CONCURRENT_LLM_REQUESTS=2
DEMO_LLM_TIMEOUT_MS=45000
DEMO_REPORT_LLM_TIMEOUT_MS=180000

# Guest lifecycle and creation abuse protection. Use a random server secret of at least 32 bytes.
# Only its HMAC output is stored; raw IP addresses are not persisted. Attempt rows may be pruned
# with the same operational retention policy as expired demo guests.
DEMO_GUEST_RETENTION_HOURS=24
DEMO_GUEST_RATE_LIMIT_MAX=10
DEMO_GUEST_RATE_LIMIT_WINDOW_MINUTES=60
DEMO_GUEST_RATE_LIMIT_SECRET=
# Render has one trusted proxy hop. Set 0 for direct local traffic if needed.
DEMO_TRUST_PROXY_HOPS=1

# Server-only embedding provider. Public-demo chat/report never falls back to this credential.
OPENAI_EMBEDDING_API_KEY=
EMBEDDING_RATE_LIMIT_MAX_CALLS_PER_MINUTE=60

# User API key encryption at rest
SECRET_ENCRYPTION_KEY=
