{
	"name": "rag-advisor-demo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.18.0",
	"scripts": {
		"dev": "pnpm --filter @rag-advisor-demo/server dev",
		"dev:client": "pnpm --filter @rag-advisor-demo/client dev",
		"build": "turbo run build",
		"build:static": "pnpm --filter @rag-advisor-demo/client build:static",
		"typecheck": "pnpm typecheck:shared && pnpm build:shared && pnpm typecheck:server && pnpm typecheck:client",
		"typecheck:shared": "tsc --project packages/shared/tsconfig.json --noEmit",
		"typecheck:server": "cross-env NODE_OPTIONS=--conditions=development tsc --project packages/server/tsconfig.json --noEmit",
		"typecheck:client": "cross-env NODE_OPTIONS=--conditions=development tsc --project packages/client/tsconfig.json --noEmit",
		"test": "pnpm test:server && pnpm test:client",
		"test:server": "pnpm --filter @rag-advisor-demo/server test",
		"test:client": "pnpm --filter @rag-advisor-demo/client test",
		"preflight:finance": "pnpm --filter @rag-advisor-demo/server fixture:preflight:finance",
		"eval:finance": "pnpm --filter @rag-advisor-demo/server fixture:evaluate:finance",
		"seed:finance": "pnpm --filter @rag-advisor-demo/server fixture:seed:finance",
		"smoke:finance": "pnpm --filter @rag-advisor-demo/server fixture:smoke:finance",
		"db:generate": "pnpm --filter @rag-advisor-demo/server db:generate",
		"db:check": "pnpm --filter @rag-advisor-demo/server db:check",
		"db:migrate": "pnpm --filter @rag-advisor-demo/server db:migrate",
		"db:studio": "pnpm --filter @rag-advisor-demo/server db:studio",
		"db:up": "docker compose up -d postgres supertokens",
		"db:down": "docker compose down",
		"smoke:local": "node scripts/smoke-local.mjs",
		"smoke:local:auth": "node scripts/smoke-local.mjs --auth",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "pnpm format:check",
		"check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
		"build:shared": "pnpm --filter @rag-advisor-demo/shared build",
		"build:client": "pnpm --filter @rag-advisor-demo/client build",
		"build:server": "pnpm --filter @rag-advisor-demo/server build",
		"clean": "turbo run clean && rimraf dist node_modules",
		"clean:dist": "turbo run clean && rimraf dist",
		"clean:vite": "rimraf .vite_cache",
		"start": "node packages/server/dist/server.js",
		"update:check": "pnpm outdated -r",
		"update:all": "pnpm update -r --latest"
	},
	"devDependencies": {
		"@types/node": "^24.6.2",
		"@vitejs/plugin-react": "^5.0.4",
		"cross-env": "^10.1.0",
		"prettier": "^3.6.2",
		"rimraf": "^6.0.1",
		"tsx": "4.20.6",
		"turbo": "^2.5.8",
		"typescript": "^5.9.3",
		"vite": "^7.1.7",
		"vite-plugin-node-polyfills": "^0.24.0",
		"vite-plugin-svgr": "^4.5.0",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"pnpm": {
		"overrides": {
			"rollup": "npm:@rollup/wasm-node",
			"tsx": "4.20.6"
		}
	}
}
